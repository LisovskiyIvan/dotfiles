# Linux-only overrides — подключается из ghostty/config через config-file = ?"~/.config/ghostty/config.linux"
# Этот файл попадёт в ~/.config/ghostty/config.linux на Linux через `apply.sh` (ghostty::${HOME}/.config/ghostty)
# На macOS он игнорируется (файла ~/.config/ghostty/config.linux нет).

# Включаем SSH-интеграцию (требует Ghostty >=1.2). На 1.1.3 будет ошибка, поэтому только в linux-оверрайде.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Фикс iowait/high CPU на Hyprland / некоторых ядрах (https://github.com/ghostty-org/ghostty/discussions/3224)
# На Linux по умолчанию auto (io_uring), если видишь iowait — включи epoll:
async-backend = epoll
