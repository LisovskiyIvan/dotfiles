{
    "global": {
        "show_additional_menu_items": true
    },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Left Control → Left Command (external keyboard only)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "type": "device_if",
                                        "identifiers": [
                                            {
                                                "product_id": 58566,
                                                "vendor_id": 13357
                                            },
                                            {
                                                "product_id": 20580,
                                                "vendor_id": 12815
                                            }
                                        ]
                                    }
                                ],
                                "from": {
                                    "key_code": "left_control",
                                    "modifiers": {
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_command"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Caps Lock → Left Control",
                        "manipulators": [
                            {
                                "conditions": [],
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": {
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_control"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Screenshots on Cmd+Opt → keep Cmd+Shift free for Aerospace (screencapture via shell)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "3",
                                    "modifiers": {
                                        "mandatory": [
                                            "command",
                                            "option",
                                            "shift"
                                        ],
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "/usr/sbin/screencapture -c"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "4",
                                    "modifiers": {
                                        "mandatory": [
                                            "command",
                                            "option",
                                            "shift"
                                        ],
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "/usr/sbin/screencapture -i -c"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "3",
                                    "modifiers": {
                                        "mandatory": [
                                            "command",
                                            "option"
                                        ],
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "loc=$(/usr/bin/defaults read com.apple.screencapture location 2>/dev/null || echo \"$HOME/Desktop\"); /usr/sbin/screencapture \"$loc/Screenshot $(/bin/date '+%Y-%m-%d at %H.%M.%S').png\""
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "4",
                                    "modifiers": {
                                        "mandatory": [
                                            "command",
                                            "option"
                                        ],
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "loc=$(/usr/bin/defaults read com.apple.screencapture location 2>/dev/null || echo \"$HOME/Desktop\"); /usr/sbin/screencapture -i \"$loc/Screenshot $(/bin/date '+%Y-%m-%d at %H.%M.%S').png\""
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "5",
                                    "modifiers": {
                                        "mandatory": [
                                            "command",
                                            "option"
                                        ],
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "loc=$(/usr/bin/defaults read com.apple.screencapture location 2>/dev/null || echo \"$HOME/Desktop\"); /usr/sbin/screencapture -i -o \"$loc/Screenshot $(/bin/date '+%Y-%m-%d at %H.%M.%S').png\""
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Right Command (tap alone) → toggle input source (en/ru)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "lang_is_ru",
                                        "type": "variable_if",
                                        "value": 0
                                    }
                                ],
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": {
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 250
                                },
                                "to": [
                                    {
                                        "key_code": "right_command",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [
                                    {
                                        "select_input_source": {
                                            "input_source_id": "com.apple.keylayout.Russian",
                                            "language": "ru"
                                        }
                                    },
                                    {
                                        "set_variable": {
                                            "name": "lang_is_ru",
                                            "value": 1
                                        }
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "lang_is_ru",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": {
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 250
                                },
                                "to": [
                                    {
                                        "key_code": "right_command",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [
                                    {
                                        "select_input_source": {
                                            "input_source_id": "com.apple.keylayout.ABC",
                                            "language": "en"
                                        }
                                    },
                                    {
                                        "set_variable": {
                                            "name": "lang_is_ru",
                                            "value": 0
                                        }
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "is_pointing_device": true,
                        "product_id": 58566,
                        "vendor_id": 13357
                    },
                    "ignore": false
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": {
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}
