{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "tabs": {
    "mode": "off"
  },
  "keybinds": {
    "leader": "ctrl+\\",
    "app.exit": "ctrl+c,ctrl+с,<leader>q",
    "command.palette.show": "ctrl+p,ctrl+з",
    "prompt.editor": "<leader>e,<leader>у",
    "theme.switch": "<leader>t,<leader>е",
    "session.sidebar.toggle": "<leader>b,<leader>и",
    "opencode.status": "<leader>s,<leader>ы",
    "session.export": "<leader>x,<leader>ч",
    "session.new": "<leader>n,<leader>т",
    "session.list": "<leader>l,<leader>д",
    "session.timeline": "<leader>g,<leader>п",
    "session.rename": "ctrl+r,ctrl+к",
    "session.delete": "ctrl+d,ctrl+в",
    "session.background": "ctrl+b,ctrl+и",
    "session.pin.toggle": "ctrl+f,ctrl+а",
    "session.compact": "<leader>c,<leader>с",
    "session.queued_prompts": "<leader>q,<leader>й",
    "model.dialog.provider": "ctrl+a,ctrl+ф",
    "model.dialog.favorite": "ctrl+f,ctrl+а",
    "model.list": "<leader>m,<leader>ь",
    "agent.list": "<leader>a,<leader>ф",
    "variant.cycle": "ctrl+t,ctrl+е",
    "session.page.up": "pageup,ctrl+alt+b,ctrl+alt+и",
    "session.page.down": "pagedown,ctrl+alt+f,ctrl+alt+а",
    "session.line.up": "ctrl+alt+y,ctrl+alt+н",
    "session.line.down": "ctrl+alt+e,ctrl+alt+у",
    "session.half.page.up": "ctrl+alt+u,ctrl+u,ctrl+alt+г,ctrl+г",
    "session.half.page.down": "ctrl+alt+d,ctrl+d,ctrl+alt+в,ctrl+в",
    "session.first": "ctrl+g,home,ctrl+п",
    "session.last": "ctrl+alt+g,end,ctrl+alt+п",
    "messages.copy": "<leader>y,<leader>н",
    "session.undo": "<leader>u,<leader>г",
    "session.redo": "<leader>r,<leader>к",
    "diff.close": "escape,q,й",
    "diff.next_hunk": "],ъ",
    "diff.previous_hunk": "[,х",
    "diff.next_file": "n,т",
    "diff.previous_file": "p,з",
    "diff.toggle_file_tree": "b,и",
    "diff.single_patch": "s,ы",
    "diff.switch_source": "d,в",
    "diff.toggle_view": "v,м",
    "dialog.select.prev": "up,ctrl+p,ctrl+з",
    "dialog.select.next": "down,ctrl+n,ctrl+т",
    "prompt.autocomplete.prev": "up,ctrl+p,ctrl+з",
    "prompt.autocomplete.next": "down,ctrl+n,ctrl+т",
    "prompt.clear": "ctrl+c,ctrl+с",
    "input.newline": "shift+return,ctrl+return,alt+return,ctrl+j,ctrl+о",
    "input.move.left": "left,ctrl+b,ctrl+и",
    "input.move.right": "right,ctrl+f,ctrl+а",
    "input.line.home": "ctrl+a,ctrl+ф",
    "input.line.end": "ctrl+e,ctrl+у",
    "input.select.line.home": "ctrl+shift+a,ctrl+shift+ф",
    "input.select.line.end": "ctrl+shift+e,ctrl+shift+у",
    "input.visual.line.home": "alt+a,alt+ф",
    "input.visual.line.end": "alt+e,alt+у",
    "input.select.visual.line.home": "alt+shift+a,alt+shift+ф",
    "input.select.visual.line.end": "alt+shift+e,alt+shift+у",
    "input.delete.line": "ctrl+shift+d,ctrl+shift+в",
    "input.delete.to.line.end": "ctrl+k,ctrl+л",
    "input.delete.to.line.start": "ctrl+u,ctrl+г",
    "input.delete": "ctrl+d,delete,shift+delete,ctrl+в",
    "input.undo": "ctrl+-,super+z,super+я",
    "input.redo": "ctrl+.,super+shift+z,ctrl+ю,super+shift+я",
    "input.word.forward": "alt+f,alt+right,ctrl+right,alt+а",
    "input.word.backward": "alt+b,alt+left,ctrl+left,alt+и",
    "input.select.word.forward": "alt+shift+f,alt+shift+right,alt+shift+а",
    "input.select.word.backward": "alt+shift+b,alt+shift+left,alt+shift+и",
    "input.delete.word.forward": "alt+d,alt+delete,ctrl+delete,alt+в",
    "input.delete.word.backward": "ctrl+w,ctrl+backspace,alt+backspace,ctrl+ц",
    "input.select.all": "super+a,super+ф",
    "terminal.suspend": "ctrl+z,ctrl+я"
  }
}
