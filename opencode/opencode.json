{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "enabled": true
    }
  },
  "formatter": {
    "prettier": { "disabled": true },
    "biome": { "disabled": true },
    "oxfmt": { "disabled": true },
    "bun-fmt": {
      "command": ["bun", "fmt", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".json",
        ".jsonc",
        ".css",
        ".html",
        ".htm",
        ".md",
        ".mdx",
        ".yaml",
        ".yml"
      ]
    }
  },
  "provider": {},
  "agent": {
    "build": { "disable": false },
    "plan": { "disable": true },
    "general": { "model": "opencode-go/muse-spark-1.3-contributor" },
    "explore": { "model": "opencode-go/muse-spark-1.3-contributor" },
    "scout": { "model": "opencode-go/muse-spark-1.3-contributor" }
  }
}
