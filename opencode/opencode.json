{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "enabled": true
    },
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/Users/ivan/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
  "formatter": {
    "prettier": { "disabled": true },
    "biome": { "disabled": true },
    "oxfmt": {
      "command": ["oxfmt", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts"
      ]
    }
  },
  "plugins": ["opencode-antigravity-auth@2.1.2"],
  "provider": {},
  "agent": {
    "build": { "disable": false },
    "plan": { "disable": true },
    "general": { "model": "opencode-go/muse-spark-1.3-contributor" },
    "explore": { "model": "opencode-go/muse-spark-1.3-contributor" },
    "scout": { "model": "opencode-go/muse-spark-1.3-contributor" }
  }
}
