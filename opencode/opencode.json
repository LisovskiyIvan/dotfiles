{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": true,
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/home/dayme/.local/bin/browse",
          "mcp"
        ],
        "cwd": "/home/dayme",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      },
      "fff": {
        "type": "local",
        "command": ["fff-mcp"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "formatter": {
    "prettier": { "disabled": true },
    "biome": { "disabled": true },
    "oxfmt": {
      "command": ["oxfmt", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts"
      ]
    }
  },
  "provider": {},
  "agents": {
    "build": { "disabled": false },
    "plan": { "disabled": true },
    "general": { "model": "opencode-go/hy4-flash-free" },
    "explore": { "model": "opencode-go/hy4-flash-free" },
    "scout": { "model": "opencode-go/hy4-flash-free" }
  }
}
