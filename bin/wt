#!/usr/bin/env bash
# Create and delete git worktrees, open/close them as Rex sessions.
set -euo pipefail

ROOT="${WT_ROOT:-$HOME/.config/rex/worktree}"

if [ -n "${WT_REPO:-}" ]; then
  REPO="$WT_REPO"
else
  REPO=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi

# Main worktree, so removal still works when called from inside a worktree.
MAIN_REPO=$(git -C "$REPO" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}' || true)
[ -n "$MAIN_REPO" ] || MAIN_REPO="$REPO"

usage() {
  cat <<'EOF'
wt — git worktree + Rex helper

usage:
  wt new NAME        create worktree + branch NAME, open Rex session
  wt delete NAME     remove worktree, branch and Rex session
  wt list            list worktrees
  wt prompt          interactive prompt (used by Rex hotkey)
EOF
}

die() { printf 'wt: %s\n' "$*" >&2; exit 1; }

valid_name() { [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; }

branch_exists() { git -C "$MAIN_REPO" show-ref --verify --quiet "refs/heads/$1"; }

select_session() {
  local sid="$1" cid
  [ "${WT_NO_SELECT:-0}" = "1" ] && return 0
  cid=$(rex client ls --json 2>/dev/null |
    jq -r '.clients[]? | select(.info.kind == "app") | .client_id' 2>/dev/null | head -n 1)
  [ -n "$cid" ] || return 0
  rex -C "$cid" do session.select "session_id=$sid" >/dev/null 2>&1 || true
}

# Sessions with any pane's cwd inside DIR (works even if label was renamed).
session_ids_for_dir() {
  local dir="$1" sid bid proc cwd
  rex ls --json 2>/dev/null | jq -r '.sessions[]?.session_id' 2>/dev/null | while IFS= read -r sid; do
    [ -n "$sid" ] || continue
    rex session inspect "$sid" --json 2>/dev/null |
      jq -r '.windows[]?.layers[]?.blocks[]?.block_id' 2>/dev/null |
      while IFS= read -r bid; do
        [ -n "$bid" ] || continue
        proc=$(rex block call -s "$sid" -b "$bid" process 2>/dev/null || true)
        printf '%s' "$proc" | jq -r '.. | objects | .cwd? // empty' 2>/dev/null |
          while IFS= read -r cwd; do
            case "$cwd" in
              "$dir"|"$dir"/*) printf '%s\n' "$sid" ;;
            esac
          done
      done
  done
}

cmd_new() {
  local name="${1:-}" dir out sid
  [ -n "$name" ] || { usage >&2; exit 2; }
  valid_name "$name" || die "bad name (letters, digits, . _ - only): $name"
  [ -n "$REPO" ] && [ -d "$REPO/.git" ] || die "not in a git repo (cd into one or set WT_REPO)"

  dir="$ROOT/$name"
  [ ! -e "$dir" ] || die "already exists: $dir"
  branch_exists "$name" && die "branch already exists: $name"

  mkdir -p "$ROOT"
  git -C "$REPO" worktree add -b "$name" "$dir" >&2

  sid=""
  out=$(rex new "$name" -c "$dir" --json 2>/dev/null || true)
  if [ -n "$out" ]; then
    sid=$(printf '%s' "$out" | jq -r '.session_id // empty' 2>/dev/null || true)
  fi
  [ -z "$sid" ] || select_session "$sid"

  printf 'created %s -> %s\n' "$name" "$dir"
}

cmd_delete() {
  local name="${1:-}" dir sid self keep=""
  [ -n "$name" ] || { usage >&2; exit 2; }
  valid_name "$name" || die "bad name: $name"

  dir="$ROOT/$name"
  if [ -d "$dir" ]; then
    git -C "$MAIN_REPO" worktree unlock "$dir" >/dev/null 2>&1 || true
    git -C "$MAIN_REPO" worktree remove --force "$dir" >&2 || rm -rf "$dir"
  else
    git -C "$MAIN_REPO" worktree prune >/dev/null 2>&1 || true
  fi

  if branch_exists "$name"; then
    git -C "$MAIN_REPO" branch -D "$name" >/dev/null 2>&1
  fi

  # Close by label and by location. Includes the session the command runs in.
  local targets
  targets=$({
    rex ls --json 2>/dev/null |
      jq -r --arg n "$name" '.sessions[]? | select(.label == $n) | .session_id' 2>/dev/null || true
    session_ids_for_dir "$dir"
  } | sort -u)

  self="${REX_SESSION:-}"
  for sid in $targets; do
    [ -n "$sid" ] || continue
    if [ -n "$self" ] && [ "$sid" = "$self" ]; then
      keep="$sid"
      continue
    fi
    rex kill "$sid" >/dev/null 2>&1 || true
  done

  printf 'deleted %s\n' "$name"

  # Own session last, detached, so this command can finish first.
  if [ -n "$keep" ]; then
    (nohup rex kill "$keep" >/dev/null 2>&1 &)
  fi
}

cmd_prompt() {
  local name base="${2:-}"
  if [ -n "$base" ] && [ -d "$base" ]; then
    WT_REPO=$(git -C "$base" rev-parse --show-toplevel 2>/dev/null || true)
    export WT_REPO
    REPO="$WT_REPO"
  fi
  printf '\033[1mworktree name\033[0m: '
  IFS= read -r name || exit 0
  name=$(printf '%s' "$name" | tr -d '[:space:]')
  [ -n "$name" ] || exit 0
  if ! "$0" new "$name"; then
    printf '\nfailed. press enter to close...\n'
    IFS= read -r || true
  fi
}

case "${1:-}" in
  new|n)    shift; cmd_new "$@" ;;
  delete|d|rm) shift; cmd_delete "$@" ;;
  list|ls)
    if [ -n "$REPO" ]; then
      git -C "$REPO" worktree list
    else
      ls -1 "$ROOT" 2>/dev/null || true
    fi
    ;;
  prompt)   cmd_prompt ;;
  *)        usage; exit 2 ;;
esac
