#!/usr/bin/env bash
# Create and delete git worktrees, open/close them as Rex sessions.
set -euo pipefail

ROOT="${WT_ROOT:-$HOME/.config/rex/worktree}"

if [ -n "${WT_REPO:-}" ]; then
  REPO="$WT_REPO"
else
  REPO=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi

# Main worktree, so removal still works when called from inside a worktree.
MAIN_REPO=$(git -C "$REPO" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}' || true)
[ -n "$MAIN_REPO" ] || MAIN_REPO="$REPO"

usage() {
  cat <<'EOF'
wt — git worktree + Rex helper

usage:
  wt new NAME        create worktree + branch NAME, open tab in current session
  wt delete NAME     remove worktree, branch and its tab
  wt list            list worktrees
  wt prompt          interactive prompt (used by Rex hotkey)
EOF
}

die() { printf 'wt: %s\n' "$*" >&2; exit 1; }

valid_name() { [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; }

branch_exists() { git -C "$MAIN_REPO" show-ref --verify --quiet "refs/heads/$1"; }

# Tabs to close: label match or any pane's cwd inside DIR.
# Prints "session_id window_id" lines.
window_targets() {
  local dir="$1" name="$2" sid view w b proc cwd
  rex ls --json 2>/dev/null | jq -r '.sessions[]?.session_id' 2>/dev/null | while IFS= read -r sid; do
    [ -n "$sid" ] || continue
    view=$(rex session inspect "$sid" --json 2>/dev/null || true)

    printf '%s' "$view" | jq -r --arg n "$name" '.windows[]? | select(.label == $n) | .window_id' 2>/dev/null |
      while IFS= read -r w; do
        [ -n "$w" ] && printf '%s %s\n' "$sid" "$w"
      done

    printf '%s' "$view" | jq -r '.windows[] | .window_id as $w | .layers[]?.blocks[]?.block_id | "\($w) \(.)"' 2>/dev/null |
      while read -r w b; do
        [ -n "$w" ] && [ -n "$b" ] || continue
        proc=$(rex block call -s "$sid" -b "$b" process 2>/dev/null || true)
        printf '%s' "$proc" | jq -r '.. | objects | .cwd? // empty' 2>/dev/null |
          while IFS= read -r cwd; do
            case "$cwd" in
              "$dir"|"$dir"/*) printf '%s %s\n' "$sid" "$w" ;;
            esac
          done
      done
  done
}

cmd_new() {
  local name="${1:-}" dir out id
  [ -n "$name" ] || { usage >&2; exit 2; }
  valid_name "$name" || die "bad name (letters, digits, . _ - only): $name"
  [ -n "$REPO" ] && [ -d "$REPO/.git" ] || die "not in a git repo (cd into one or set WT_REPO)"

  dir="$ROOT/$name"
  [ ! -e "$dir" ] || die "already exists: $dir"
  branch_exists "$name" && die "branch already exists: $name"

  mkdir -p "$ROOT"
  git -C "$REPO" worktree add -b "$name" "$dir" >&2

  out=""
  if [ -n "${REX_SESSION:-}" ]; then
    # New tab in the current session.
    out=$(rex window new -s "$REX_SESSION" "$name" -c "$dir" --json 2>/dev/null || true)
    if [ -n "$out" ]; then
      id=$(printf '%s' "$out" | jq -r '.window_id // empty' 2>/dev/null || true)
      [ -z "$id" ] || rex focus -s "$REX_SESSION" "$id" >/dev/null 2>&1 || true
    fi
  else
    # Plain shell: no current session, fall back to a new one.
    out=$(rex new "$name" -c "$dir" --json 2>/dev/null || true)
  fi

  printf 'created %s -> %s\n' "$name" "$dir"
}

cmd_delete() {
  local name="${1:-}" dir dir_phys sid w own_s="${REX_SESSION:-}" own_w="" count defer_s="" defer_w=""
  [ -n "$name" ] || { usage >&2; exit 2; }
  valid_name "$name" || die "bad name: $name"

  dir="$ROOT/$name"
  dir_phys=$(cd "$dir" 2>/dev/null && pwd -P || printf '%s' "$dir")
  if [ -d "$dir" ]; then
    git -C "$MAIN_REPO" worktree unlock "$dir" >/dev/null 2>&1 || true
    git -C "$MAIN_REPO" worktree remove --force "$dir" >&2 || rm -rf "$dir"
  else
    git -C "$MAIN_REPO" worktree prune >/dev/null 2>&1 || true
  fi

  if branch_exists "$name"; then
    git -C "$MAIN_REPO" branch -D "$name" >/dev/null 2>&1
  fi

  if [ -n "$own_s" ] && [ -n "${REX_BLOCK:-}" ]; then
    own_w=$(rex block inspect "$REX_BLOCK" --json 2>/dev/null | jq -r '.block.window_id // empty' 2>/dev/null || true)
  fi

  while read -r sid w; do
    [ -n "$sid" ] && [ -n "$w" ] || continue
    count=$(rex session inspect "$sid" --json 2>/dev/null | jq '.windows | length' 2>/dev/null || echo 0)
    [ "$count" -gt 1 ] || continue
    if [ "$sid" = "$own_s" ] && [ "$w" = "$own_w" ]; then
      defer_s="$sid"; defer_w="$w"
      continue
    fi
    rex window close -s "$sid" "$w" >/dev/null 2>&1 || true
  done < <(window_targets "$dir_phys" "$name" | sort -u)

  printf 'deleted %s\n' "$name"

  # Own tab last, detached, so this command can finish first.
  if [ -n "$defer_s" ] && [ -n "$defer_w" ]; then
    (nohup rex window close -s "$defer_s" "$defer_w" >/dev/null 2>&1 &)
  fi
}

cmd_prompt() {
  local name base="${2:-}"
  if [ -n "$base" ] && [ -d "$base" ]; then
    WT_REPO=$(git -C "$base" rev-parse --show-toplevel 2>/dev/null || true)
    export WT_REPO
    REPO="$WT_REPO"
  fi
  printf '\033[1mworktree name\033[0m: '
  IFS= read -r name || exit 0
  name=$(printf '%s' "$name" | tr -d '[:space:]')
  [ -n "$name" ] || exit 0
  if ! "$0" new "$name"; then
    printf '\nfailed. press enter to close...\n'
    IFS= read -r || true
  fi
}

case "${1:-}" in
  new|n)    shift; cmd_new "$@" ;;
  delete|d|rm) shift; cmd_delete "$@" ;;
  list|ls)
    if [ -n "$REPO" ]; then
      git -C "$REPO" worktree list
    else
      ls -1 "$ROOT" 2>/dev/null || true
    fi
    ;;
  prompt)   cmd_prompt ;;
  *)        usage; exit 2 ;;
esac
